{
  "manifest_version": 3,
  "name": "풀림 - 우클릭·드래그·복사 제한 해제",
  "short_name": "풀림",
  "version": "1.0.0",
  "description": "자바스크립트로 우클릭 · 글자 선택(드래그) · 복사를 막아 둔 사이트에서 다시 쓸 수 있게 풀어 줍니다. 크롬 · 엣지 · 네이버 웨일.",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "풀림",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/unlock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "homepage_url": "https://github.com/omokdie/pullim"
}
